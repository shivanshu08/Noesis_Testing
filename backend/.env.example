# Noesis Testing Platform - Environment Configuration
# Copy this to .env and update values

# Server
PORT=3000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=noesis_testing
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=noesis-testing-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h

# ST Automation Project Path
ST_AUTOMATION_SOURCE=git
ST_AUTOMATION_PATH=D:\\ST Automation
ST_AUTOMATION_GIT_REPO_URL=https://github.com/prashantguleria/AutomationTesting.git
ST_AUTOMATION_GIT_CACHE_PATH=D:\\ST Automation\\.cache\\automation-testing-repo
ST_AUTOMATION_GIT_BRANCH=main
ST_AUTOMATION_REPORTS_PATH=D:\\ST Automation\\noesis-reports
ST_AUTOMATION_APP_URL=
MAVEN_HOME=C:\\Program Files\\Apache\\maven

# CORS
CORS_ORIGIN=http://localhost:4200

# Mail notifications for execution completion
# When enabled, run pass/fail emails are sent to active admin and tester users.
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=replace_with_smtp_password
MAIL_FROM="Noesis Testing <no-reply@example.com>"
APP_BASE_URL=http://localhost:4200
